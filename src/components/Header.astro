---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navItems = [
  { label: 'Início', href: '/' },
  { label: 'Clínica Veterinária', href: '/clinica-veterinaria' },
  { label: 'Banho e Tosa', href: '/banho-e-tosa' },
  { label: 'Pet Shop', href: '/pet-shop' },
  { label: 'Contato', href: '/contato' },
];

const isActive = (href: string) => {
  if (href === '/' && (currentPath === '/' || currentPath === '')) return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
};
---

<header class="header">
  <div class="container">
    <div class="header-inner">
      <a href="/" class="logo">
        <div class="logo-icon" aria-hidden="true">🐾</div>
        <div class="logo-text">
          Bicho Feliz
          <span>Clínica Vet. e Pet Shop</span>
        </div>
      </a>
      <nav class="nav" aria-label="Menu principal">
        {navItems.map((item) => (
          <a href={item.href} class={isActive(item.href) ? 'active' : ''}>
            {item.label}
          </a>
        ))}
      </nav>
      <div class="header-actions">
        <a href="https://wa.me/5583999991234" target="_blank" rel="noopener" class="btn btn-whatsapp btn-sm btn-header-wa" aria-label="Contato via WhatsApp">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm.01 1.67c4.56 0 8.25 3.69 8.25 8.24 0 2.2-.86 4.28-2.42 5.84a8.18 8.18 0 01-5.83 2.41c-1.42 0-2.82-.37-4.06-1.07l-.29-.17-3.02.79.81-2.94-.19-.3a8.163 8.163 0 01-1.29-4.36c0-4.55 3.69-8.24 8.24-8.24zm4.52 11.59c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.5-1.4-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1s.9 2.44 1.02 2.61c.13.17 1.77 2.7 4.28 3.79.6.26 1.07.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/></svg>
          WhatsApp
        </a>
        <button id="btn-hamburger" class="btn-hamburger" aria-label="Abrir menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Menu -->
<div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu de navegação">
  <div class="mobile-menu-panel">
    <div class="mobile-menu-header">
      <div class="logo">
        <div class="logo-icon" aria-hidden="true">🐾</div>
        <div class="logo-text">Bicho Feliz <span>Clínica Vet. e Pet Shop</span></div>
      </div>
      <button id="btn-close-menu" class="btn-close-menu" aria-label="Fechar menu">✕</button>
    </div>
    <nav class="mobile-menu-nav" aria-label="Menu móvel">
      <a href="/" class={isActive('/') ? 'active' : ''}>🏠 Início</a>
      <a href="/clinica-veterinaria" class={isActive('/clinica-veterinaria') ? 'active' : ''}>🏥 Clínica Veterinária</a>
      <a href="/banho-e-tosa" class={isActive('/banho-e-tosa') ? 'active' : ''}>🛁 Banho e Tosa</a>
      <a href="/pet-shop" class={isActive('/pet-shop') ? 'active' : ''}>🛍️ Pet Shop</a>
      <a href="/contato" class={isActive('/contato') ? 'active' : ''}>📍 Contato</a>
    </nav>
    <div class="mobile-menu-footer">
      <a href="https://wa.me/5583999991234" target="_blank" rel="noopener" class="btn btn-whatsapp">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm.01 1.67c4.56 0 8.25 3.69 8.25 8.24 0 2.2-.86 4.28-2.42 5.84a8.18 8.18 0 01-5.83 2.41c-1.42 0-2.82-.37-4.06-1.07l-.29-.17-3.02.79.81-2.94-.19-.3a8.163 8.163 0 01-1.29-4.36c0-4.55 3.69-8.24 8.24-8.24zm4.52 11.59c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.5-1.4-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1s.9 2.44 1.02 2.61c.13.17 1.77 2.7 4.28 3.79.6.26 1.07.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/></svg>
